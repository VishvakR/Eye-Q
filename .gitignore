# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment & secrets
.env
.env.*

# Test & tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Runtime data — SQLite database and alert evidence JPEGs.
# Leading slash so this only matches the project-root directory.
/data/

# Model weights. Auto-downloaded on first run: yolov8n.pt (~6 MB) and the
# VLM cache (~3.5 GB for Moondream2). Never commit these — a fresh clone
# re-fetches them, and git handles multi-GB binaries badly.
/models/
*.pt
*.onnx
*.safetensors
*.gguf

# Media. Sample/demo footage is large and reproducible from the source
# camera; keep it out of history.
*.mp4
*.avi
*.mov
*.mkv

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Note: uv.lock IS committed — it pins the exact dependency graph so
# `uv sync` reproduces this environment.
