  /* ── Figures ──────────────────────────────────────────────── */

  figure { margin: 0 0 2.5mm; break-inside: avoid; }
  figure svg { width: 100%; height: auto; display: block; margin: 0 auto; }
  figure.tight svg { width: 95%; }
  figcaption {
    font-size: 7.9pt; line-height: 1.4; color: var(--muted);
    border-top: 0.5pt solid var(--rule); margin-top: 1.8mm; padding-top: 1.5mm;
  }
  figcaption b { color: var(--ink); font-weight: 600; }

  /* ── Tables ───────────────────────────────────────────────── */

  table {
    width: 100%; border-collapse: collapse; margin: 0 0 2.5mm;
    font-size: 7.9pt; line-height: 1.30; break-inside: avoid;
  }
