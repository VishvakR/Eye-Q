    font-size: 11pt; line-height: 1.34; color: var(--ink);
    margin: 0 0 4mm; max-width: 150mm; font-weight: 400;
  }

  .meta {
    font-family: "SF Mono", Menlo, Consolas, monospace;
    font-size: 7.8pt; color: var(--muted);
    border-top: 0.5pt solid var(--rule); border-bottom: 0.5pt solid var(--rule);
    padding: 1.8mm 0; margin: 0 0 5mm;
  }

  h2 {
    font-size: 13pt; letter-spacing: -0.012em; color: var(--ink);
    font-weight: 700; margin: 0 0 2.5mm;
    padding-bottom: 1.6mm; border-bottom: 1pt solid var(--ink);
  }
  h2 .num { color: var(--accent); margin-right: 2.2mm; }

  h3 {
    font-size: 9.2pt; color: var(--ink); font-weight: 700;
    margin: 3mm 0 1.2mm; letter-spacing: 0.002em;
  }

  p { margin: 0 0 2.2mm; }
  p.lead { font-size: 10pt; color: var(--ink); }
  .abstract p { text-align: justify; hyphens: auto; }

  code, .mono {
    font-family: "SF Mono", Menlo, Consolas, monospace;
